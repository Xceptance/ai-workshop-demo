# Environment Variables Example
# You can copy this file to .env or create an api.key file in the root directory.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-3.7-flash, fallback to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL_NAME=gemini-3.7-flash

# Port for the web application (default: 8080)
PORT=8080
